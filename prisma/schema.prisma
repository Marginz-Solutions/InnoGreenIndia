generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AdminContact {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone            String
  altPhone         String?  @map("alt_phone")
  email            String?
  website          String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  lat              Decimal? @db.Decimal(10, 6)
  lng              Decimal? @db.Decimal(10, 6)
  altitude         String?
  accuracy         String?
  operatingHours   String?  @map("operating_hours")
  timezone         String?
  commanderName    String?  @map("commander_name")
  commanderContact String?  @map("commander_contact")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([city], map: "index_admin_contact_city")
  @@index([email], map: "index_admin_contact_email")
  @@index([state], map: "index_admin_contact_state")
  @@map("admin_contact")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BrandCategory {
  brandId    String   @map("brand_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  brands     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  @@id([brandId, categoryId])
  @@map("brand_categories")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Brand {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String?         @unique
  description     String?
  logoUrl         String          @map("logo_url")
  imageUrl        String?         @map("image_url")
  websiteUrl      String?         @map("website_url")
  contactId       String?         @map("contact_id") @db.Uuid
  tags            String[]        @default([])
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  brandCategories BrandCategory[]
  contacts        Contact?        @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products        Product[]

  @@index([isActive], map: "index_brands_is_active")
  @@index([slug], map: "index_brands_slug")
  @@map("brands")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Category {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String          @unique
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  brandCategories BrandCategory[]
  dealers         Dealer[]
  products        Product[]

  @@index([name], map: "index_categories_name")
  @@map("categories")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Contact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String?  @unique
  phoneNo      String   @unique(map: "contacts_phoneno_key") @map("phone_no")
  whatsapp     String   @unique
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  state        String?
  pincode      String?
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(6)
  brands       Brand[]

  @@index([id], map: "index_contacts_categories_id")
  @@index([email], map: "index_contacts_email")
  @@index([phoneNo], map: "index_contacts_phone_no")
  @@map("contacts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Dealer {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmName         String    @map("firm_name")
  gstNumber        String?   @map("gst_number")
  mobileNo         String?   @map("mobile_no")
  district         String?
  categoryInterest String?   @map("category_interest") @db.Uuid
  monthlyVolume    String?   @map("monthly_volume")
  submittedAt      DateTime? @map("submitted_at") @db.Timestamp(6)
  status           String?
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamp(6)
  categories       Category? @relation(fields: [categoryInterest], references: [id], onDelete: Cascade)

  @@map("dealers")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Product {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @default("Test Product")
  slug             String    @default("test-product")
  brandId          String?   @default(dbgenerated("gen_random_uuid()")) @map("brand_id") @db.Uuid
  categoryId       String?   @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  description      String?   @default("Test")
  imageUrl         String?   @default("") @map("image_url")
  tags             String[]  @default([])
  isActive         Boolean?  @default(true) @map("is_active")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  sku              String?   @unique
  featured         Boolean?  @default(false)
  status           String?   @default("active")
  shortDescription String?   @map("short_description")
  brands           Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categories       Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("products")
}
