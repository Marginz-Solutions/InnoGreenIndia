generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String             @unique
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  brandCategories BrandCategory[]
  dealers          dealers[]

  @@index([name], map: "index_categories_name")
  @@map("categories")
}

model Contact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String?  @unique
  phoneNo      String   @unique(map: "contacts_phoneno_key") @map("phone_no")
  whatsapp     String   @unique
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  state        String?
  pincode      String?
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  brands       Brand[]

  @@index([id], map: "index_contacts_categories_id")
  @@index([email], map: "index_contacts_email")
  @@index([phoneNo], map: "index_contacts_phone_no")
  @@map("contacts")
}

model Brand {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String?            @unique
  description      String?
  logoUrl          String             @map("logo_url")
  imageUrl         String?            @map("image_url")
  websiteUrl       String?            @map("website_url")
  contactId        String?            @map("contact_id") @db.Uuid
  tags             String[]           @default([])
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  brandCategories BrandCategory[]
  contact          Contact?           @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([isActive], map: "index_brands_is_active")
  @@index([slug], map: "index_brands_slug")
  @@map("brands")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin_contact {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone             String
  alt_phone         String?
  email             String?
  website           String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  lat               Decimal? @db.Decimal(10, 6)
  lng               Decimal? @db.Decimal(10, 6)
  altitude          String?
  accuracy          String?
  operating_hours   String?
  timezone          String?
  commander_name    String?
  commander_contact String?
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @db.Timestamp(6)

  @@index([city], map: "index_admin_contact_city")
  @@index([email], map: "index_admin_contact_email")
  @@index([state], map: "index_admin_contact_state")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BrandCategory {
  brandId    String   @db.Uuid @map("brand_id")
  categoryId String   @db.Uuid @map("category_id")
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  @@id([brandId, categoryId])
  @@map("brand_categories")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dealers {
  id                BigInt    @id @default(autoincrement())
  firm_name         String
  gst_number        String?
  mobile_no         String?
  district          String?
  category_interest String?   @db.Uuid
  monthly_volume    String?
  submitted_at      DateTime? @db.Timestamp(6)
  status            String?
  reviewed_at       DateTime? @db.Timestamp(6)
  categories        Category? @relation(fields: [category_interest], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id               String    @id(map: "Products_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @default("Test Product")
  slug             String    @default("test-product")
  brandId          String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description      String?   @default("Test")
  imageUrl         String?   @default("")
  contactName      String?   @default("Test")
  contactPhone     String?   @default("8945869858")
  contactEmail     String?   @default("test@gmail.com")
  tags             String[]  @default([])
  isActive         Boolean?  @default(true)
  createdAt        DateTime? @default(now()) @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @db.Timestamp(6)
  sku              String?   @unique(map: "Products_sku_key")
  featured         Boolean?  @default(false)
  status           String?   @default("active")
  shortDescription String?
}
